# FunctionCraft-SLM Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional Teacher Model API (for synthetic data distillation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hugging Face Hub (for downloading base models / uploading fine-tuned adapters)
HF_TOKEN=

# Model Artifacts Path
MODEL_PATH=models/functioncraft-qwen-1.5b-dpo
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
DEVICE=cpu # 'cuda' on GPU machines, 'cpu' for local dev

# Prometheus Telemetry
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
