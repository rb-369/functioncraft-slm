{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "create_support_ticket",
  "description": "Opens an enterprise customer support ticket in Zendesk/Jira with routing metadata.",
  "parameters": {
    "type": "object",
    "properties": {
      "customer_id": {
        "type": "string",
        "pattern": "^CUST-[0-9]{5,8}$",
        "description": "Unique customer identifier (format: CUST-XXXXX)."
      },
      "subject": {
        "type": "string",
        "minLength": 5,
        "maxLength": 100,
        "description": "Brief summary of the issue."
      },
      "category": {
        "type": "string",
        "enum": ["billing", "technical_outage", "account_access", "feature_request"],
        "description": "Issue classification category."
      },
      "priority": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"],
        "description": "Calculated priority level."
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional routing tags."
      }
    },
    "required": ["customer_id", "subject", "category", "priority"],
    "additionalProperties": false
  }
}
